PROJECT_NAME="AI Resume Analyzer"
VERSION="1.0.0"
API_V1_STR="/api/v1"
SECRET_KEY="REPLACE_WITH_PRODUCTION_SECRET_KEY_CHANGE_THIS_IN_PROD"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Use SQLite for easy local testing or PostgreSQL in production:
# DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/resume_analyzer"
DATABASE_URL="sqlite+aiosqlite:///./resume_analyzer.db"

# Gemini AI API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

MAX_FILE_SIZE_MB=10
